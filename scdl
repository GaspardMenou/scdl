#!/usr/bin/env bash
#
# scdl — télécharge des sons SoundCloud, les tague proprement, et les prépare
#        soit pour Apple Music (import auto), soit pour Rekordbox (mode DJ).
#
# Usage :  scdl <url> [<url>...]
#          scdl --dj <url-du-set>
#          scdl --help
#
set -euo pipefail

# --------------------------------------------------------------- chemins ---
# scdl est symlinké dans le PATH : on remonte au vrai dossier pour trouver
# scdl-genre et genres.conf à côté.
SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
  LINK="$(readlink "$SELF")"
  [[ "$LINK" == /* ]] && SELF="$LINK" || SELF="$(dirname "$SELF")/$LINK"
done
SCDLDIR="$(cd "$(dirname "$SELF")" && pwd)"
# shellcheck source=scdl-lib.sh
source "$SCDLDIR/scdl-lib.sh"

# ---------------------------------------------------------------- config ---
AUTOADD="$HOME/Music/Music/Media.localized/Automatically Add to Music.localized"
STAGING="$HOME/Music/SoundCloud-DL"
DJLIB="$HOME/Music/rekordbox/SoundCloud"   # casse identique au dossier de Rekordbox

MODE="music"      # music (Apple Music) | keep (dossier simple) | dj (Rekordbox)
FORMAT=""         # vide = choisi selon le mode
GENRE=""          # tag genre forcé (option -g)
ALBUM=""          # tag album forcé (option -A)
USE_ARCHIVE=1     # 0 avec --no-archive
DEST=""           # dossier de sortie si --keep / --dj
BROWSER=""        # navigateur pour les cookies (option -c)
MAXITEMS=""       # limite de morceaux (option -n)
BYGENRE=1         # défaut : un dossier par genre — 0 avec --by-set
BYGENRE_EXPLICIT=0 # 1 si l'utilisateur a écrit -G lui-même

usage() {
  cat <<'EOF'
scdl — SoundCloud → Apple Music ou Rekordbox

  scdl <url> [<url>...]      télécharge et importe dans Apple Music
  scdl --dj <url>            mode DJ : prépare le tout pour Rekordbox

Destination
  -k, --keep [dir]     ni Apple Music ni Rekordbox, juste un dossier
                       (défaut : ~/Music/SoundCloud-DL)
  -d, --dj [dir]       mode Rekordbox : meilleure qualité dispo, un dossier
                       par set, numérotation, et une playlist .m3u8 à importer
                       (défaut : ~/Music/Rekordbox/SoundCloud)

Qualité
  -c, --login <nav>    utilise tes cookies SoundCloud (safari, chrome, firefox,
                       brave, edge) pour récupérer les fichiers ORIGINAUX quand
                       l'artiste les propose — réservés aux comptes connectés
  -a, --m4a            force le m4a/AAC        --mp3   force le mp3

Tags
  -g, --genre <nom>    force le tag "Genre" (ex : -g "Hard Techno")
  -A, --album <nom>    force le tag "Album"

Rangement (modes --dj et --keep ; Apple Music range par tags, pas par dossiers)
  -S, --by-set         un dossier par set, morceaux numérotés dans l'ordre
                       (par défaut : un dossier par genre)

Divers
  -n, --max <N>        ne prend que les N premiers morceaux
      --no-archive     retélécharge même si déjà pris une fois
  -h, --help           cette aide

Fonctionne avec une URL de morceau, de set/playlist, de profil d'artiste,
ou de tes likes (https://soundcloud.com/<toi>/likes avec --login).
EOF
}

# --------------------------------------------------------------- options ---
urls=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -a|--m4a)     FORMAT="m4a"; shift ;;
    --mp3)        FORMAT="mp3"; shift ;;
    -g|--genre)   [[ -n "${2:-}" ]] || die "-g attend un nom de genre"
                  GENRE="$2"; shift 2 ;;
    -A|--album)   [[ -n "${2:-}" ]] || die "-A attend un nom d'album"
                  ALBUM="$2"; shift 2 ;;
    -c|--login)   [[ -n "${2:-}" ]] || die "-c attend un navigateur (safari, chrome, firefox…)"
                  BROWSER="$2"; shift 2 ;;
    -n|--max)     [[ "${2:-}" =~ ^[0-9]+$ ]] || die "-n attend un nombre"
                  MAXITEMS="$2"; shift 2 ;;
    -G|--by-genre) BYGENRE=1; BYGENRE_EXPLICIT=1; shift ;;
    -S|--by-set)   BYGENRE=0; shift ;;
    -k|--keep)    MODE="keep"
                  if [[ -n "${2:-}" && "$2" != -* ]]; then DEST="$2"; shift 2; else shift; fi ;;
    -d|--dj)      MODE="dj"
                  if [[ -n "${2:-}" && "$2" != -* ]]; then DEST="$2"; shift 2; else shift; fi ;;
    --no-archive) USE_ARCHIVE=0; shift ;;
    -h|--help)    usage; exit 0 ;;
    -*)           die "option inconnue : $1 (voir --help)" ;;
    *)            urls+=("$1"); shift ;;
  esac
done

[[ ${#urls[@]} -gt 0 ]] || { usage; exit 1; }
command -v yt-dlp >/dev/null || die "yt-dlp introuvable — installe-le avec : brew install yt-dlp"
command -v ffmpeg >/dev/null || die "ffmpeg introuvable — installe-le avec : brew install ffmpeg"

case "$MODE" in
         # Apple Music range par tags et recopie les fichiers dans sa propre
         # arborescence : les dossiers de genre n'y survivraient pas.
  music) [[ $BYGENRE_EXPLICIT -eq 0 ]] || die "--by-genre n'a pas d'effet sur Apple Music : il range par tags, pas par\ndossiers. Le tag Genre est déjà rempli. Utilise --dj ou --keep."
         BYGENRE=0
         [[ -d "$AUTOADD" ]] || die "dossier d'import Apple Music introuvable :\n  $AUTOADD\nUtilise --keep ou --dj."
         FINAL="$AUTOADD"; ARCHIVE="$STAGING/.archive.txt"; mkdir -p "$STAGING" ;;
  keep)  FINAL="${DEST:-$STAGING}";  ARCHIVE="$FINAL/.archive.txt"; mkdir -p "$FINAL" ;;
  dj)    FINAL="${DEST:-$DJLIB}";    ARCHIVE="$FINAL/.archive.txt"; mkdir -p "$FINAL" ;;
esac

WORK="$(mktemp -d "${TMPDIR:-/tmp}/scdl.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT

# ---------------------------------------------------------------- yt-dlp ---
# Nettoyage des titres et tags : identique dans tous les modes.
args=(
  --embed-metadata
  --embed-thumbnail
  --convert-thumbnails jpg               # les pochettes webp ne s'embarquent pas
  # 1. groupe entre crochets/parenthèses dédié UNIQUEMENT au free download → on jette tout
  --replace-in-metadata title "(?i)[\[\({<]\s*(?:click\s+)?(?:buy\s*(?:link)?\s*(?:=|for|->|→)\s*)?free\s*(?:dl|d\s*/\s*l|download)s?\s*[\]\)}>]" ""
  # 2. formule "click buy for free dl" hors crochets
  --replace-in-metadata title "(?i)(?:click\s+)?buy\s*(?:link)?\s*(?:=|for|->|→)\s*free\s*(?:dl|d\s*/\s*l|download)s?" ""
  # 3. mention libre : on retire la mention SANS toucher aux parenthèses autour,
  #    sinon "(Free DL extended)" laisserait un "extended)" orphelin
  --replace-in-metadata title "(?i)[*!|~_]*\s*\bfree\s*(?:dl|d\s*/\s*l|download)s?\b\s*[*!|~_]*" " "
  # 4. préfixes de promo en début de titre : "PREMIERE:", "Exclusive -", "OUT NOW |"…
  --replace-in-metadata title "(?i)^\s*[\[\(]?\s*(premi[eè]re|premier|exclusive|exclu|out\s*now)\s*[\]\)]?\s*[:|\-–]\s*" ""
  # 5. restes : espaces collés aux parenthèses, groupes vides, séparateurs orphelins
  --replace-in-metadata title "([\(\[\{])\s+" "\1"
  --replace-in-metadata title "\s+([\)\]\}])" "\1"
  --replace-in-metadata title "[\(\[\{]\s*[\)\]\}]" ""
  --replace-in-metadata title "\s{2,}" " "
  --replace-in-metadata title "^[\s\-–—|:,*]+" ""
  --replace-in-metadata title "[\s\-–—|:,*]+$" ""
  --parse-metadata "%(uploader)s:%(artist)s"          # artiste = compte SoundCloud…
  --parse-metadata "%(title)s:%(artist)s - %(title)s" # …sauf si le titre est "Artiste - Titre"
  # recopie vers les champs que ffmpeg écrit réellement dans le fichier
  --parse-metadata "%(artist)s:%(meta_artist)s"
  --parse-metadata "%(title)s:%(meta_title)s"
  # genre : celui de SoundCloud, sinon le 1er tag du morceau, sinon rien
  --parse-metadata "%(genre,tags.0|)s:%(meta_genre)s"
  # album = nom du set si c'en est un, sinon le titre du morceau (traité comme un single)
  --parse-metadata "%(playlist,title)s:%(meta_album)s"
  --parse-metadata "%(playlist_uploader,artist)s:%(meta_album_artist)s"
  --extract-audio
  --no-overwrites
  --ignore-errors
  --no-progress
  --console-title
  --trim-filenames 150
  --paths "$WORK"
)

# Dossier de genre : la valeur forcée par -g si elle existe (sinon le dossier
# et le tag se contrediraient), sinon celle de SoundCloud puis le 1er tag.
if [[ $BYGENRE -eq 1 ]]; then
  if [[ -n "$GENRE" ]]; then
    GENREDIR="${GENRE//\//-}"; GENREDIR="${GENREDIR//%/}"   # ni sous-dossier ni syntaxe de template
  else
    GENREDIR='%(genre,tags.0|Sans genre)s'
  fi
fi

if [[ "$MODE" == "dj" ]]; then
  # Priorité à la qualité : l'original si le compte y donne droit, sinon le
  # meilleur débit (l'AAC 160k de SoundCloud bat son MP3 128k). Aucun
  # ré-encodage : "best" garde le codec source tel quel.
  [[ -n "$BROWSER" ]] && args+=( --format "download/bestaudio" ) \
                      || args+=( --format "bestaudio" )
  args+=( --format-sort "abr,asr" --audio-format "${FORMAT:-best}" )
  if [[ $BYGENRE -eq 1 ]]; then
    # pas de numérotation : l'ordre d'un set n'a plus de sens dans un bac par genre
    args+=( --output "$GENREDIR/%(artist,uploader)s - %(title)s.%(ext)s" )
  else
    args+=( --output "%(playlist|Singles)s/%(playlist_index&{:02d} - |)s%(artist,uploader)s - %(title)s.%(ext)s" )
  fi
  QUALITE="meilleure qualité dispo"
else
  # Apple Music : on privilégie le format déjà servi par SoundCloud pour
  # éviter un ré-encodage lossy→lossy.
  FORMAT="${FORMAT:-mp3}"
  args+=(
    --format bestaudio
    --format-sort "acodec:$FORMAT,abr"
    --audio-format "$FORMAT"
    --audio-quality 0
  )
  if [[ $BYGENRE -eq 1 ]]; then
    args+=( --output "$GENREDIR/%(title)s.%(ext)s" )
  else
    args+=( --output "%(title)s.%(ext)s" )
  fi
  QUALITE="$FORMAT"
fi

# tags forcés : ffmpeg les reçoit via shlex, d'où les quotes pour les valeurs à espaces
overrides=""
add_override() { local esc="${2//\'/\'\\\'\'}"; overrides+=" -metadata $1='$esc'"; }
[[ -n "$GENRE" ]] && add_override genre "$GENRE"
[[ -n "$ALBUM" ]] && add_override album "$ALBUM"
[[ -n "$overrides" ]]    && args+=( --postprocessor-args "Metadata:${overrides# }" )
[[ -n "$BROWSER" ]]      && args+=( --cookies-from-browser "$BROWSER" )
[[ -n "$MAXITEMS" ]]     && args+=( --playlist-items "1:$MAXITEMS" )
[[ $USE_ARCHIVE -eq 1 ]] && args+=( --download-archive "$ARCHIVE" )

say "▸ Téléchargement (${QUALITE})…"
yt-dlp "${args[@]}" "${urls[@]}" || true

# ----------------------------------------------------------- déplacement ---
count=0

# Sous-dossiers : par set en mode DJ, par genre avec --by-genre.
if [[ "$MODE" == "dj" || $BYGENRE -eq 1 ]]; then
  shopt -s nullglob
  subdirs=( "$WORK"/*/ )
  shopt -u nullglob
  [[ ${#subdirs[@]} -gt 0 ]] || { info "Rien de nouveau (déjà téléchargé, ou aucun son trouvé)."; exit 0; }

  for sdir in "${subdirs[@]}"; do
    raw="$(basename "$sdir")"
    if [[ $BYGENRE -eq 1 ]]; then
      name="$(ensure_canonical_dir "$FINAL" "$(norm_genre "$raw")")"
    else
      name="$(resolve_dir "$FINAL" "$raw")"          # les noms de set restent intacts
      mkdir -p "$FINAL/$name"
    fi
    target="$FINAL/$name"
    say "▸ ${name}"
    while IFS= read -r -d '' f; do
      moved="$(move_unique "$f" "$target")"
      [[ $BYGENRE -eq 1 ]] && retag_genre "$moved" "$name"   # tag aligné sur le dossier
      retitle "$moved"                                        # "Titre / Hard Techno" → "Titre"
      printf '  %s✓%s %s\n' "$grn" "$off" "$(basename "$moved")"
      (( count++ ))
    done < <(list_audio "$sdir")
    if [[ "$MODE" == "dj" ]]; then
      write_m3u8 "$target" "$name"        # régénérée à chaque fois : reste à jour
      printf '  %s→ playlist : %s%s\n' "$dim" "$target/$name.m3u8" "$off"
    fi
  done

  [[ $count -gt 0 ]] || { info "Rien de nouveau (déjà téléchargé, ou aucun son trouvé)."; exit 0; }
  if [[ "$MODE" == "dj" ]]; then
    say "▸ ${count} son(s) prêt(s) pour Rekordbox dans : $FINAL"
    info "Dans Rekordbox : Fichier › Importer › Playlist… puis choisis le .m3u8"
    info "Rekordbox analysera BPM et tonalité tout seul à l'import."
  else
    say "▸ ${count} son(s) enregistré(s) dans : $FINAL"
  fi
else
  while IFS= read -r -d '' f; do
    moved="$(move_unique "$f" "$FINAL")"
    printf '  %s✓%s %s\n' "$grn" "$off" "$(basename "$moved")"
    (( count++ ))
  done < <(list_audio "$WORK")

  [[ $count -gt 0 ]] || { info "Rien de nouveau (déjà téléchargé, ou aucun son trouvé)."; exit 0; }

  if [[ "$MODE" == "music" ]]; then
    say "▸ ${count} son(s) déposé(s) dans Apple Music — ils apparaissent dans ta librairie dans quelques secondes."
  else
    say "▸ ${count} son(s) enregistré(s) dans : $FINAL"
  fi
fi

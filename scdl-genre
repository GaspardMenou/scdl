#!/usr/bin/env python3
"""Résout un genre SoundCloud brut vers son nom canonique, d'après genres.conf.

    scdl-genre canon "HARDTECHNO"      -> Hard Techno
    scdl-genre canon "#hard-techno"    -> Hard Techno
    scdl-genre canon "Hard Techno/Industrial" -> Hard Techno
    scdl-genre canon "KOSMIC"          -> KOSMIC   (inconnu : conservé tel quel)

Un genre absent du dictionnaire n'est jamais perdu : il est seulement nettoyé.
"""
import re
import sys
from pathlib import Path

CONF = Path(__file__).resolve().parent / "genres.conf"
FALLBACK = "Sans genre"


def key(s: str) -> str:
    """Clé de comparaison : minuscules, sans espaces ni ponctuation."""
    return re.sub(r"[^a-z0-9]", "", s.lower())


def load(path: Path) -> dict:
    """Lit genres.conf → {clé normalisée: nom canonique}."""
    table = {}
    if not path.exists():
        return table
    canonical = None
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.split("#", 1)[0].rstrip()
        if not line.strip():
            continue
        if "=" in line:
            canonical, _, rest = line.partition("=")
            canonical = canonical.strip()
            table[key(canonical)] = canonical          # le canonique est sa propre variante
        elif canonical and line.startswith((" ", "\t")):
            rest = line                                 # continuation d'une ligne trop longue
        else:
            continue
        for variant in rest.split(","):
            variant = variant.strip()
            if variant:
                table[key(variant)] = canonical
    return table


def canon(raw: str, table: dict) -> str:
    s = (raw or "").strip()
    s = re.sub(r"^#+", "", s).strip()                   # les tags arrivent en "#techno"
    s = re.split(r"[/|｜⧸]", s)[0].strip()               # "Hard Techno/Industrial" -> "Hard Techno"
    s = re.sub(r"\s+", " ", s)
    if not s:
        return FALLBACK
    return table.get(key(s), s)


def main() -> int:
    if len(sys.argv) < 3:
        print(__doc__, file=sys.stderr)
        return 2
    table = load(CONF)
    if sys.argv[1] == "canon":
        print(canon(sys.argv[2], table))
        return 0
    if sys.argv[1] == "known":
        # code 0 si la valeur est un genre répertorié — sert à décider si un
        # suffixe de titre comme "/ Hard Techno" est bien un genre à retirer.
        return 0 if key(sys.argv[2].strip()) in table else 1
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())

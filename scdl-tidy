#!/usr/bin/env bash
#
# scdl-tidy — remet de l'ordre dans une bibliothèque déjà téléchargée :
#   • fusionne les dossiers qui désignent le même genre (genres.conf)
#   • aligne le tag Genre de chaque fichier sur son dossier
#   • régénère les playlists .m3u8 et supprime les dossiers vides
#
# Par sécurité il ne fait RIEN sans --apply : par défaut il montre le plan.
#
set -euo pipefail

SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
  LINK="$(readlink "$SELF")"
  [[ "$LINK" == /* ]] && SELF="$LINK" || SELF="$(dirname "$SELF")/$LINK"
done
# shellcheck source=scdl-lib.sh
source "$(cd "$(dirname "$SELF")" && pwd)/scdl-lib.sh"

LIB="$HOME/Music/rekordbox/SoundCloud"   # casse identique au dossier de Rekordbox
APPLY=0

usage() {
  cat <<'EOF'
scdl-tidy — range une bibliothèque scdl déjà téléchargée

  scdl-tidy [dossier]            montre ce qui serait fait (aucune modification)
  scdl-tidy [dossier] --apply    applique réellement

Sans argument, travaille sur ~/Music/Rekordbox/SoundCloud.
Le dictionnaire de genres est dans genres.conf, à côté du script.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --apply)   APPLY=1; shift ;;
    -h|--help) usage; exit 0 ;;
    -*)        die "option inconnue : $1" ;;
    *)         LIB="$1"; shift ;;
  esac
done

[[ -d "$LIB" ]] || die "dossier introuvable : $LIB"
command -v ffmpeg >/dev/null || die "ffmpeg introuvable"

PLAN="$(mktemp "${TMPDIR:-/tmp}/scdl-tidy.XXXXXX")"
trap 'rm -f "$PLAN"' EXIT

# ------------------------------------------------------------- collecte ---
# Le tag Genre du fichier fait foi ; à défaut on retombe sur le nom du dossier
# qui l'héberge (c'est de là qu'il venait). Format du plan : genre <TAB> chemin.
findexpr=(); for e in "${AUDIO_EXT[@]}"; do findexpr+=( -o -name "*.$e" ); done
while IFS= read -r -d '' f; do
  parent="$(basename "$(dirname "$f")")"
  raw="$(tag_of "$f" genre)"
  [[ -z "$raw" && "$(dirname "$f")" != "$LIB" ]] && raw="$parent"
  printf '%s\t%s\n' "$(norm_genre "$raw")" "$f" >> "$PLAN"
done < <(find "$LIB" -mindepth 1 -maxdepth 2 -type f \( "${findexpr[@]:1}" \) -print0 2>/dev/null)

[[ -s "$PLAN" ]] || { info "Aucun fichier audio dans $LIB"; exit 0; }

# --------------------------------------------------------------- rapport ---
total=$(wc -l < "$PLAN" | tr -d ' ')
moves=0; retags=0

say "▸ ${total} morceau(x) dans $LIB"
echo

while IFS= read -r genre; do
  n=$(awk -F'\t' -v g="$genre" '$1==g' "$PLAN" | wc -l | tr -d ' ')
  printf '%s%s%s  (%s)\n' "$bold" "$genre" "$off" "$n"
  while IFS=$'\t' read -r _ f; do
    from="$(basename "$(dirname "$f")")"
    cur="$(tag_of "$f" genre)"
    flags=""
    [[ "$from" != "$genre" ]] && { flags+=" ${ylw}déplacé de « $from »${off}"; moves=$((moves+1)); }
    [[ "$cur" != "$genre" && "$genre" != "Sans genre" ]] && { flags+=" ${dim}tag: « ${cur:-vide} » → « $genre »${off}"; retags=$((retags+1)); }
    printf '    %s%b\n' "$(basename "$f" | cut -c1-52)" "$flags"
  done < <(awk -F'\t' -v g="$genre" '$1==g' "$PLAN")
  echo
done < <(cut -f1 "$PLAN" | sort -u)

say "▸ ${moves} déplacement(s), ${retags} tag(s) à corriger"

if [[ $APPLY -eq 0 ]]; then
  echo
  info "Simulation seulement — relance avec --apply pour l'exécuter."
  exit 0
fi

# ------------------------------------------------------------ exécution ---
echo
say "▸ Application…"
while IFS=$'\t' read -r genre f; do
  [[ -f "$f" ]] || continue                       # déjà déplacé lors d'un doublon
  name="$(ensure_canonical_dir "$LIB" "$genre")"   # impose l'orthographe canonique
  target="$LIB/$name"
  if ! [[ "$(dirname "$f")" -ef "$target" ]]; then   # -ef : même dossier réel, casse comprise
    f="$(move_unique "$f" "$target")"
  fi
  retag_genre "$f" "$name"
  retitle "$f"
done < "$PLAN"

# Playlists régénérées (leurs chemins absolus ont changé) et dossiers vides ôtés.
find "$LIB" -mindepth 2 -maxdepth 2 \( -name '*.m3u8' -o -name '*.m3u' \) -delete 2>/dev/null || true
shopt -s nullglob
for d in "$LIB"/*/; do
  name="$(basename "$d")"
  if [[ -n "$(list_audio "$d" | tr -d '\0')" ]]; then
    write_m3u8 "$d" "$name"
  else
    rmdir "$d" 2>/dev/null && info "dossier vide supprimé : $name"
  fi
done
shopt -u nullglob

say "▸ Terminé — playlists .m3u/.m3u8 régénérées, à réimporter dans Rekordbox."
